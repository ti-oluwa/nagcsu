-- =================================================================
-- N/AGCSU RESEARCH PROGRAMME -- PHASE 2 DYNAMIC RESERVOIR SIMULATION
-- Synthetic composite pilot-sector model: "UGH-1" (OML 30 / Ughelli
-- depobelt analog, Delta State, onshore Niger Delta)
--
-- STATUS: Fully synthetic but literature/analog-calibrated dataset,
-- built because operator-grade field data could not be obtained
-- (see accompanying "Dataset Documentation" for every source and
-- correlation used, and the calibration point: the EK6 tank-model
-- data supplied by the user, treated as the one authentic Niger-
-- Delta-consistent anchor point). Representative/analog model only
-- -- not a validated replica of any specific real reservoir.
--
-- Engine: OPM Flow (black-oil, 3-phase, corner-point-free box grid)
-- Units : Field (psia, STB, Mscf, ft, cp, lb/ft3)
-- =================================================================

RUNSPEC

TITLE
 NAGCSU-UGH1-SYNTHETIC-PILOT-SECTOR

DIMENS
 30  30  5  /

OIL
GAS
WATER
DISGAS

FIELD

TABDIMS
 1  1  30  30  1  30 /

WELLDIMS
 12  5  1  12 /

AQUDIMS
 1  1  1  36  1*  1* /

EQLDIMS
-- NTEQUL NDPRVD NDRXVD NTTRVD NSTRVD
   1 /

START
 1 JAN 1976 /

NSTACK
 25 /

UNIFOUT
UNIFIN

-- =================================================================
GRID
-- =================================================================
NOECHO

DX
 4500*200.0 /
DY
 4500*200.0 /

TOPS
 900*8200.0 /

DZ
 900*40.0
 900*60.0
 900*35.0
 900*55.0
 900*45.0 /

EQUALS
 'NTG'    0.8   1 30  1 30  1 1 /
 'PORO'   0.24  1 30  1 30  1 1 /
 'PERMX'  850 1 30  1 30  1 1 /
 'PERMY'  850 1 30  1 30  1 1 /
 'PERMZ'  85.0  1 30  1 30  1 1 /
 'NTG'    0.85   1 30  1 30  2 2 /
 'PORO'   0.22  1 30  1 30  2 2 /
 'PERMX'  620 1 30  1 30  2 2 /
 'PERMY'  620 1 30  1 30  2 2 /
 'PERMZ'  62.0  1 30  1 30  2 2 /
 'NTG'    0.75   1 30  1 30  3 3 /
 'PORO'   0.2  1 30  1 30  3 3 /
 'PERMX'  410 1 30  1 30  3 3 /
 'PERMY'  410 1 30  1 30  3 3 /
 'PERMZ'  41.0  1 30  1 30  3 3 /
 'NTG'    0.9   1 30  1 30  4 4 /
 'PORO'   0.23  1 30  1 30  4 4 /
 'PERMX'  780 1 30  1 30  4 4 /
 'PERMY'  780 1 30  1 30  4 4 /
 'PERMZ'  78.0  1 30  1 30  4 4 /
 'NTG'    0.78   1 30  1 30  5 5 /
 'PORO'   0.19  1 30  1 30  5 5 /
 'PERMX'  310 1 30  1 30  5 5 /
 'PERMY'  310 1 30  1 30  5 5 /
 'PERMZ'  31.0  1 30  1 30  5 5 /
/

-- Mild areal heterogeneity multiplier so the sector isn't perfectly
-- layer-cake (keeps the model usable for gas-storage conformance /
-- sweep-efficiency work in Phase 2)
MULTIPLY
 'PERMX'  1.15   1 10  1 30  1 5 /
 'PERMX'  0.85  21 30  1 30  1 5 /
 'PERMY'  1.15   1 10  1 30  1 5 /
 'PERMY'  0.85  21 30  1 30  1 5 /
/

-- --- Analytic edge aquifer (Carter-Tracy), parameters taken directly
-- --- from the data source's "AQUIFER MODEL" block: thickness=77 ft,
-- --- reservoir radius=16137.2 ft, outer/inner radius ratio=15,
-- --- encroachment angle=56 deg, aquifer permeability=566 mD.
AQUCT
-- AqID  Depth  Pi     Perm  Poro  Ctotal    Rres     Thick  Angle  PVTNUM  Tab
   1     8700   2751.0 566   0.20  6.9E-06   16137.2  77.0   56.0   1       1*  /
/

AQUANCON
 1   1  1   1 30   1  5  'I-'  /
/

ECHO

RPTGRID
 'PORO'  'PERMX'  'PERMY'  'PERMZ'  'NTG'  'TOPS'  /

-- =================================================================
PROPS
-- =================================================================
NOECHO

